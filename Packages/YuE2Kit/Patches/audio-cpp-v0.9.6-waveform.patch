+thread_local Yue2PCMObserver pcm_observer;
+
+void deliver_pcm(const runtime::AudioBuffer & audio, size_t offset, size_t count, size_t total) {
+    const auto observer = pcm_observer;
+    if (observer.callback && observer.callback(observer.context, audio.samples.data() + offset * audio.channels,
+                                               count, audio.sample_rate, audio.channels, offset, total) != 0) {
+        throw std::runtime_error("Yue2 waveform decoding cancelled by the PCM consumer");
+    }
+}
+
+void report_progress(int stage, int completed, int total) {
+    const auto observer = pcm_observer;
+    if (observer.progress && observer.progress(observer.context, stage, completed, total) != 0) {
+        throw std::runtime_error("Yue2 rendering cancelled by the progress observer");
+    }
+}
