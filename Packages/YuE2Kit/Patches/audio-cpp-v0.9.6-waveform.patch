+    void * context, audiocpp_result ** out_result) {
+    return audiocpp_yue2_session_run_observed(session, request, callback, nullptr, context, out_result);
+}
+
+audiocpp_status audiocpp_yue2_session_run_observed(
+    audiocpp_session * session, const audiocpp_request * request, audiocpp_yue2_pcm_callback pcm,
+    audiocpp_yue2_progress_callback progress, void * context, audiocpp_result ** out_result) {
+    using engine::models::yue2::exchange_pcm_observer;
+    const auto previous = exchange_pcm_observer({pcm, progress, context});
+    const auto status = audiocpp_session_run(session, request, out_result);
+    exchange_pcm_observer(previous);
+    return status;
+}
