+audiocpp_status audiocpp_yue2_session_run_pcm(
+    audiocpp_session * session, const audiocpp_request * request, audiocpp_yue2_pcm_callback callback,
+    void * context, audiocpp_result ** out_result) {
+    using engine::models::yue2::exchange_pcm_observer;
+    const auto previous = exchange_pcm_observer({callback, context});
+    const auto status = audiocpp_session_run(session, request, out_result);
+    exchange_pcm_observer(previous);
+    return status;
+}
