+/* Delivers finalized YuE2 VAE tiles after full-song acoustic synthesis.
+ * Invoked synchronously on the calling thread. PCM lives for the call only.
+ * Return nonzero to stop decoding. Offsets are stereo frame indices. */
+typedef int (*audiocpp_yue2_pcm_callback)(void * context, const float * pcm,
+                                         size_t count, int rate, int channels,
+                                         size_t offset, size_t total);
+AUDIOCPP_API audiocpp_status audiocpp_yue2_session_run_pcm(
+    audiocpp_session * session, const audiocpp_request * request, audiocpp_yue2_pcm_callback callback,
+    void * context, audiocpp_result ** out_result);
+
+/* Reports completed synthesis steps, then the start of waveform decoding.
+ * Callbacks run synchronously. Return nonzero from either callback to cancel. */
+typedef enum audiocpp_yue2_progress_stage {
+    AUDIOCPP_YUE2_SYNTHESIS = 0,
+    AUDIOCPP_YUE2_WAVEFORM = 1
+} audiocpp_yue2_progress_stage;
+typedef int (*audiocpp_yue2_progress_callback)(void * context, int stage, int completed, int total);
+AUDIOCPP_API audiocpp_status audiocpp_yue2_session_run_observed(
+    audiocpp_session * session, const audiocpp_request * request, audiocpp_yue2_pcm_callback pcm,
+    audiocpp_yue2_progress_callback progress, void * context, audiocpp_result ** out_result);
+
