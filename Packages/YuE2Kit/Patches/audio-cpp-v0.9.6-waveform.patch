+/* Delivers finalized YuE2 VAE tiles after full-song acoustic synthesis.
+ * Invoked synchronously on the calling thread. PCM lives for the call only.
+ * Return nonzero to stop decoding. Offsets are stereo frame indices. */
+typedef int (*audiocpp_yue2_pcm_callback)(void * context, const float * pcm,
+                                         size_t count, int rate, int channels,
+                                         size_t offset, size_t total);
+AUDIOCPP_API audiocpp_status audiocpp_yue2_session_run_pcm(
+    audiocpp_session * session, const audiocpp_request * request, audiocpp_yue2_pcm_callback callback,
+    void * context, audiocpp_result ** out_result);
+
